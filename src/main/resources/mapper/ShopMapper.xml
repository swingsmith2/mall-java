<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.mapper.ShopMapper">

    <resultMap id="ShopMap" type="com.mall.domain.Shop">
        <id property="id" column="id"/>
        <result property="ownerId" column="owner_id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="forcedCloseReason" column="forced_close_reason"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="insert" resultType="long">
        INSERT INTO shops (owner_id, name, description, status)
        VALUES (#{ownerId}, #{name}, #{description}, #{status})
        RETURNING id
    </select>

    <select id="findById" resultMap="ShopMap">
        SELECT * FROM shops WHERE id = #{id}
    </select>

    <select id="findByOwnerId" resultMap="ShopMap">
        SELECT * FROM shops WHERE owner_id = #{ownerId}
    </select>

    <select id="listAll" resultMap="ShopMap">
        SELECT * FROM shops ORDER BY id
    </select>

    <update id="forceClose">
        UPDATE shops
        SET status = 'FORCED_CLOSED', forced_close_reason = #{reason}
        WHERE id = #{id} AND status = 'OPEN'
    </update>
</mapper>
