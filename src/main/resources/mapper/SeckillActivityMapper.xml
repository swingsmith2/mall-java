<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.mapper.SeckillActivityMapper">

    <resultMap id="ActivityMap" type="com.mall.domain.SeckillActivity">
        <id property="id" column="id"/>
        <result property="productId" column="product_id"/>
        <result property="seckillPriceCent" column="seckill_price_cent"/>
        <result property="stock" column="stock"/>
        <result property="startAt" column="start_at"/>
        <result property="endAt" column="end_at"/>
        <result property="perUserLimit" column="per_user_limit"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="insert" resultType="long">
        INSERT INTO seckill_activities
            (product_id, seckill_price_cent, stock, start_at, end_at, per_user_limit, status)
        VALUES
            (#{productId}, #{seckillPriceCent}, #{stock}, #{startAt}, #{endAt}, #{perUserLimit}, #{status})
        RETURNING id
    </select>

    <select id="findById" resultMap="ActivityMap">
        SELECT * FROM seckill_activities WHERE id = #{id}
    </select>

    <select id="listRunning" resultMap="ActivityMap">
        SELECT * FROM seckill_activities WHERE status = 'RUNNING' ORDER BY id
    </select>

    <update id="markEnded">
        UPDATE seckill_activities SET status = 'ENDED' WHERE id = #{id} AND status = 'RUNNING'
    </update>
</mapper>
