<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.mapper.ProductMapper">

    <resultMap id="ProductMap" type="com.mall.domain.Product">
        <id property="id" column="id"/>
        <result property="categoryId" column="category_id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="priceCent" column="price_cent"/>
        <result property="stock" column="stock"/>
        <result property="status" column="status"/>
        <result property="version" column="version"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findById" resultMap="ProductMap">
        SELECT * FROM products WHERE id = #{id}
    </select>

    <select id="listOnSale" resultMap="ProductMap">
        SELECT * FROM products WHERE status = 1 ORDER BY id
        OFFSET #{offset} LIMIT #{limit}
    </select>

    <select id="countOnSale" resultType="int">
        SELECT COUNT(*) FROM products WHERE status = 1
    </select>

    <update id="decreaseStock">
        UPDATE products
        SET stock = stock - #{qty},
            version = version + 1,
            updated_at = NOW()
        WHERE id = #{id} AND stock >= #{qty} AND status = 1
    </update>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO products (category_id, name, description, price_cent, stock, status)
        VALUES (#{categoryId}, #{name}, #{description}, #{priceCent}, #{stock}, #{status})
    </insert>
</mapper>
