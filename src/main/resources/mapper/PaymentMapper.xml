<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mall.mapper.PaymentMapper">

    <resultMap id="PaymentMap" type="com.mall.domain.Payment">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="paymentNo" column="payment_no"/>
        <result property="amountCent" column="amount_cent"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByPaymentNo" resultMap="PaymentMap">
        SELECT * FROM payments WHERE payment_no = #{paymentNo}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO payments (order_id, payment_no, amount_cent, status)
        VALUES (#{orderId}, #{paymentNo}, #{amountCent}, #{status})
    </insert>
</mapper>
